# build output (build.sh writes these; CI uploads the APK as an artifact instead)
build/
dist/
out/
lab/out/

# installable/binary artifacts must never be tracked
*.apk
*.idsig
*.zip
*.aab
*.dex

# signing material — never commit a keystore or its passwords
*.jks
*.keystore
github-secrets.txt
release-keystore.*
*.p12
*.pepk
keystore/
*.b64

# editor / OS noise
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/

# java noise
*.class
*.log
hs_err_pid*

# python noise (the bytecode verifier is run from source)
__pycache__/
*.pyc

# ── v3.4.6 — Flutter add-to-app + Gradle host hygiene ────────────────────────
# machine-local Android SDK / Flutter SDK paths (never commit a runner path)
android/local.properties
local.properties
# Gradle host build output + daemon state
android/.gradle/
android/build/
android/app/build/
android/.kotlin/
# Flutter module ephemeral state (regenerated by `flutter pub get`)
ui/.dart_tool/
ui/.android/
ui/.flutter-plugins
ui/.flutter-plugins-dependencies
ui/build/
ui/.packages
ui/.metadata
**/ephemeral/
# ui/pubspec.lock IS tracked (reproducible resolution) and so are the .ttf fonts
